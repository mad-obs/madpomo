{
  "name": "madpomo",
  "short_name": "madpomo",
  "description": "A task board with a pomodoro timer built into it. It counts how many pomodoros you finish, not how many you start.",
  "id": "madpomo-react",
  "start_url": "./index.html#/board",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "lang": "en",
  "dir": "ltr",
